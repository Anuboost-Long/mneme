      "checks": [],
      "triggers": [
        {
          "name": "agent_connection_delete",
          "sql": "CREATE TRIGGER agent_connection_delete BEFORE DELETE ON agent_connection BEGIN\n      SELECT RAISE(ABORT, 'Delete this connection’s conversations first.')\n        WHERE EXISTS (SELECT 1 FROM agent_conversation WHERE agent_connection_id = OLD.id);\n      DELETE FROM agent_usage WHERE agent_connection_id = OLD.id;\n    END"
        },
        {
          "name": "agent_connection_identity",
          "sql": "CREATE TRIGGER agent_connection_identity BEFORE UPDATE OF kind, command, args ON agent_connection\n    WHEN (NEW.kind != OLD.kind OR NEW.command != OLD.command OR coalesce(NEW.args, '[]') != coalesce(OLD.args, '[]'))\n      AND EXISTS (SELECT 1 FROM agent_conversation WHERE agent_connection_id = OLD.id)\n    BEGIN\n      SELECT RAISE(ABORT, 'This connection has conversations. Add another connection to use a different command.');\n    END"
        }
      ]
    },

        },
        {
          "name": "agent_message_touch",
          "sql": "CREATE TRIGGER agent_message_touch AFTER INSERT ON agent_message BEGIN\n      UPDATE agent_conversation SET updated_at = datetime('now'),\n        title = CASE WHEN NEW.role = 'user' AND title IS NULL THEN substr(NEW.content, 1, 80) ELSE title END\n        WHERE id = NEW.conversation_id;\n    END"

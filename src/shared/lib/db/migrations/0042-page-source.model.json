          "check": "length(trim(name)) > 0"
        },
        {
          "name": "kind",
          "type": "TEXT",
          "notNull": true,
          "check": "kind IN ('claude', 'codex', 'gemini', 'copilot', 'cursor', 'custom')"
        },
        {

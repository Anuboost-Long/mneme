      "triggers": [
        {
          "name": "agent_conversation_delete",
          "sql": "CREATE TRIGGER agent_conversation_delete BEFORE DELETE ON agent_conversation BEGIN\n      DELETE FROM agent_message WHERE conversation_id = OLD.id;\n      UPDATE agent_usage SET conversation_id = NULL WHERE conversation_id = OLD.id;\n    END"
        },
        {
          "name": "agent_conversation_identity",
          "sql": "CREATE TRIGGER agent_conversation_identity BEFORE UPDATE OF agent_connection_id ON agent_conversation\n    WHEN NEW.agent_connection_id != OLD.agent_connection_id BEGIN\n      SELECT RAISE(ABORT, 'A conversation cannot switch agents.');\n    END"
        },
        {
          "name": "agent_conversation_insert",
          "sql": "CREATE TRIGGER agent_conversation_insert BEFORE INSERT ON agent_conversation BEGIN\n      SELECT RAISE(ABORT, 'This agent connection no longer exists.')\n        WHERE NOT EXISTS (SELECT 1 FROM agent_connection WHERE id = NEW.agent_connection_id);\n    END"
        }
      ]

{
  "name": "mneme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "chain dev",
    "build": "chain build",
    "build:mac": "chain build --target aarch64-apple-darwin && chain build --target x86_64-apple-darwin",
    "build:win": "chain build --target x86_64-pc-windows-msvc",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:web": "vite",
    "dev:website": "npm --prefix website run dev",
    "build:web": "tsc && vite build",
    "test": "node --test \"tests/*.test.mjs\"",
    "bench": "node tests/perf/bench.mjs"
  },
  "dependencies": {
    "@chain/sdk": "file:../chain-sdk/packages/sdk",
    "@floating-ui/dom": "^1.8.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "clsx": "^2",
    "jotai": "^2.20.3",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "pdfjs-dist": "^6.3.289",
    "prosemirror-view": "^1.42.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@chain/cli": "file:../chain-sdk/packages/cli",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "chain": {
    "gpl": true,
    "permissions": {
      "microphone": "Mneme records lectures and notes you choose to capture.",
      "speechRecognition": "Mneme turns your recordings into text on this Mac."
    }
  }
}
